<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · Bookshelf" : "Bookshelf" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Bookshelf">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <nav class="nav container">
        <%= link_to root_path, class: "brand" do %>
          <%= render "shared/book_icon", size: 26 %>
          Bookshelf
        <% end %>

        <% if authenticated? %>
          <div class="nav-main">
            <%= link_to "Books", books_path, class: ["nav-link", ("active" if controller_name == "books")] %>
            <%= link_to "Exchange shelf", exchanges_path, class: ["nav-link", ("active" if controller_name == "exchanges")] %>
            <%= link_to "Members", users_path, class: ["nav-link", ("active" if controller_name == "users")] %>
            <%= link_to exchange_requests_path, class: ["nav-link", ("active" if controller_name == "exchange_requests")] do %>
              Requests
              <% if (waiting = Current.user.received_exchange_requests.pending.count) > 0 %>
                <span class="nav-count" aria-label="<%= pluralize(waiting, "request") %> waiting for you"><%= waiting %></span>
              <% end %>
            <% end %>
            <% if Current.user.admin? %>
              <%= link_to "Reports", admin_reports_path, class: ["nav-link", ("active" if controller_path == "admin/reports")] %>
            <% end %>
          </div>
        <% end %>

        <div class="nav-links">
          <% if authenticated? %>
            <span class="nav-user">
              <%= link_to Current.user.name, Current.user, class: "nav-user-name", title: "Signed in as #{Current.user.name} — your profile" %>
              <% if Current.user.admin? %><span class="badge">Admin</span><% end %>
            </span>
            <%= link_to "Add a book", new_book_path, class: "btn btn-primary" %>
            <%= button_to "Sign out", session_path, method: :delete, class: "btn btn-ghost" %>
          <% else %>
            <%= link_to "Sign in", new_session_path, class: "btn btn-ghost" %>
            <%= link_to "Sign up", new_registration_path, class: "btn btn-primary" %>
          <% end %>
        </div>
      </nav>
    </header>

    <main class="container">
      <% flash.each do |type, message| %>
        <div class="flash flash-<%= type %>" role="status"><%= message %></div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="site-footer">
      Bookshelf — a home for your books
    </footer>
  </body>
</html>
