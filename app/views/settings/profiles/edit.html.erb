<% content_for :title, "Profile settings" %>
<%= render layout: "settings/layout" do %>
  <h2>Profile</h2>
  <%= form_with model: @user, url: settings_profile_path, method: :patch, class: "form" do |form| %>
    <%= render "shared/form_errors", object: @user %>

    <div class="field">
      <%= form.label :name %>
      <%= form.text_field :name, required: true, autocomplete: "name", class: "input" %>
    </div>

    <div class="field">
      <%= form.label :email_address, "Email address" %>
      <%= form.email_field :email_address, required: true, autocomplete: "username", class: "input" %>
    </div>

    <div class="field">
      <%= form.label :city, "Town or city" %>
      <%= form.text_field :city, maxlength: 60, autocomplete: "address-level2", placeholder: "e.g. Dar es Salaam", class: "input" %>
      <span class="field-hint">Optional. Shown to members on your profile (never publicly), and used to show books near you first on the Exchange shelf.</span>
    </div>

    <div class="field checkbox-field">
      <%= form.check_box :public_profile %>
      <div>
        <%= form.label :public_profile, "Public profile" %>
        <span class="field-hint">
          Anyone — even without an account — can read your profile, your books and your reviews, share links to them,
          and find them on Google. Your town, email, comments, lending, swaps and messages always stay private.
          <% if @user.public_profile? %><br><%= link_to "See your profile as visitors do", user_path(@user, as: "visitor") %><% end %>
        </span>
      </div>
    </div>

    <div class="field">
      <%= label_tag :current_password, "Current password" %>
      <%= password_field_tag :current_password, nil, autocomplete: "current-password", class: "input" %>
      <span class="field-hint">Only needed if you change your email address.</span>
    </div>

    <div class="form-actions">
      <%= form.submit "Save profile", class: "btn btn-primary" %>
    </div>
  <% end %>
<% end %>
