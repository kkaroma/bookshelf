<% kind = Flag::KINDS.fetch(@flaggable.class.name) %>
<% content_for :title, @flaggable.is_a?(Book) ? "Report “#{@flaggable.title}”" : "Report a #{kind}" %>

<div class="form-page">
  <%= link_to "← Back", back_path, class: "back-link" %>

  <div class="card">
    <h1><%= @flaggable.is_a?(Book) ? "Report this book" : "Report a #{kind}" %></h1>
    <p class="muted">Tell the site's admins what's wrong. <%= @flaggable.user.name %> won't be told who reported it.</p>

    <% if @flaggable.is_a?(Comment) %>
      <blockquote class="flag-quote">
        <strong><%= @flaggable.user.name %></strong> on “<%= @flaggable.book.title %>”:
        <p><%= truncate(@flaggable.body, length: 400) %></p>
      </blockquote>
    <% elsif @flaggable.is_a?(DirectMessage) %>
      <blockquote class="flag-quote">
        <strong><%= @flaggable.sender.name %></strong> wrote to you:
        <p><%= truncate(@flaggable.body, length: 400) %></p>
      </blockquote>
      <p class="field-hint">Only this message is shown to the admins — not the rest of your conversation.</p>
    <% else %>
      <div class="request-target">
        <%= render "books/mini_cover", book: @flaggable %>
        <div>
          <strong><%= @flaggable.title %></strong>
          <p class="muted">by <%= @flaggable.author %> · added by <%= @flaggable.user.name %></p>
        </div>
      </div>
    <% end %>

    <%= form_with model: @flag, url: flags_path(flaggable_param(@flaggable)), class: "form" do |form| %>
      <%= render "shared/form_errors", object: @flag %>

      <fieldset class="field flag-reasons">
        <legend>What's wrong?</legend>
        <% Flag::REASONS.each do |value, label| %>
          <label class="flag-reason">
            <%= form.radio_button :reason, value, required: true %>
            <%= label %>
          </label>
        <% end %>
      </fieldset>

      <div class="field">
        <%= form.label :note, "Anything else the admins should know?" %>
        <%= form.textarea :note, maxlength: 1000, rows: 3, class: "input" %>
        <span class="field-hint">Optional, unless you chose “Something else”.</span>
      </div>

      <div class="form-actions">
        <%= form.submit "Send report", class: "btn btn-primary" %>
        <%= link_to "Cancel", back_path, class: "btn btn-ghost" %>
      </div>
    <% end %>
  </div>
</div>
