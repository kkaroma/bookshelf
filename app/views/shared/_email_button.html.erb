<%# A big link that looks like a button in email programs. Locals: text, url %>
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:20px 0;">
  <tr>
    <td style="background:#7a3e1d; border-radius:8px;">
      <a href="<%= url %>" style="display:inline-block; padding:12px 22px; color:#ffffff; font-weight:600; text-decoration:none;"><%= text %></a>
    </td>
  </tr>
</table>
