<%# "← Previous · Page 2 of 5 · Next →". Keeps the rest of the address (like a
    search) and only changes ?page=. Local: pagination %>
<% if pagination.multiple_pages? %>
  <% page_url = ->(number) { url_for(request.query_parameters.merge(page: (number unless number == 1))) } %>
  <nav class="pagination" aria-label="Pages">
    <% if pagination.previous_page %>
      <%= link_to "← Previous", page_url.(pagination.previous_page), class: "btn btn-secondary btn-sm", rel: "prev" %>
    <% else %>
      <span class="btn btn-secondary btn-sm" aria-disabled="true">← Previous</span>
    <% end %>

    <span class="pagination-info">
      Page <%= pagination.page %> of <%= pagination.total_pages %>
      <span class="muted">· <%= pagination.first_item %>–<%= pagination.last_item %> of <%= pagination.total_count %></span>
    </span>

    <% if pagination.next_page %>
      <%= link_to "Next →", page_url.(pagination.next_page), class: "btn btn-secondary btn-sm", rel: "next" %>
    <% else %>
      <span class="btn btn-secondary btn-sm" aria-disabled="true">Next →</span>
    <% end %>
  </nav>
<% end %>
