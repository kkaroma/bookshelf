<% content_for :title, @user.name %>

<section class="profile card">
  <span class="avatar avatar-lg" style="--hue: <%= avatar_hue(@user) %>" aria-hidden="true"><%= initials(@user.name) %></span>

  <div class="profile-main">
    <h1>
      <%= @user.name %>
      <% if @user.admin? %><span class="badge">Admin</span><% end %>
      <% if @user.suspended? && Current.user.admin? %><span class="badge badge-danger">Suspended</span><% end %>
    </h1>
    <p class="muted">
      <% if @user.city %>📍 <%= @user.city %> · <% end %>Member since <%= @user.created_at.strftime("%B %Y") %>
      <% if @user == Current.user %> · <%= link_to "Settings", settings_path %><% end %>
    </p>

    <div class="profile-stats">
      <span><strong><%= @user.books_count %></strong> <%= "book".pluralize(@user.books_count) %></span>
      <%= link_to following_user_path(@user) do %>
        <strong><%= @user.following_count %></strong> following
      <% end %>
      <%= render "users/follow_box", user: @user %>
    </div>

    <% if @user == Current.user %>
      <p class="visibility-note">
        <% if @user.publicly_visible? %>
          🌍 Your profile is public. <%= link_to "See it as visitors do", user_path(@user, as: "visitor") %>
        <% else %>
          🔒 Only members can see your profile. <%= link_to "Make it public", edit_settings_profile_path %>
        <% end %>
      </p>
    <% end %>
    <% if @user.publicly_visible? %>
      <div class="profile-actions"><%= render "shared/share_button", url: user_url(@user), title: "#{@user.name} on Bookshelf" %></div>
    <% end %>

    <% if @user != Current.user && !@user.suspended? %>
      <div class="profile-actions">
        <%= button_to user_conversation_path(@user), class: "btn btn-secondary btn-sm" do %>
          <%= render "shared/chat_icon" %> Message
        <% end %>
      </div>
    <% end %>
  </div>
</section>

<% mine = @user == Current.user %>
<% if @currently_reading.any? %>
  <p class="currently-reading">
    <strong><%= mine ? "I'm currently reading" : "Currently reading" %>:</strong>
    <%= safe_join(@currently_reading.map { |book| link_to(book.title, book) }, ", ") %>
  </p>
<% end %>

<h2 class="section-title"><%= mine ? "My books" : "#{@user.name}'s books" %></h2>

<%= render layout: "books/search", locals: {
      url: user_path(@user), filters: @filters, books: @books, pagination: @pagination, show_status: true,
      label: mine ? "Search my books" : "Search #{@user.name}'s books",
      placeholder: mine ? "Search my books by title, author or ISBN…" : "Search #{@user.name.split.first}'s books…",
      total_label: pluralize(@pagination.total_count, "book") } do %>
  <p class="muted"><%= mine ? "You haven't added any books yet." : "#{@user.name} hasn't added any books yet." %></p>
<% end %>

<%= render "users/past_books", user: @user, books: @past_books, mine: mine %>
