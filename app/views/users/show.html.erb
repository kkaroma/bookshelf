<% content_for :title, @user.name %>

<section class="profile card">
  <span class="avatar avatar-lg" style="--hue: <%= avatar_hue(@user) %>" aria-hidden="true"><%= initials(@user.name) %></span>

  <div class="profile-main">
    <h1>
      <%= @user.name %>
      <% if @user.admin? %><span class="badge">Admin</span><% end %>
    </h1>
    <p class="muted">
      Member since <%= @user.created_at.strftime("%B %Y") %>
      <% if @user == Current.user %> · <%= link_to "Settings", settings_path %><% end %>
    </p>

    <div class="profile-stats">
      <span><strong><%= @user.books_count %></strong> <%= "book".pluralize(@user.books_count) %></span>
      <%= link_to following_user_path(@user) do %>
        <strong><%= @user.following_count %></strong> following
      <% end %>
      <%= render "users/follow_box", user: @user %>
    </div>
  </div>
</section>

<% mine = @user == Current.user %>
<h2 class="section-title"><%= mine ? "My books" : "#{@user.name}'s books" %></h2>

<%= render layout: "books/search", locals: {
      url: user_path(@user), query: @query, books: @books, pagination: @pagination,
      label: mine ? "Search my books" : "Search #{@user.name}'s books",
      placeholder: mine ? "Search my books by title, author or ISBN…" : "Search #{@user.name.split.first}'s books…",
      total_label: pluralize(@pagination.total_count, "book") } do %>
  <p class="muted"><%= mine ? "You haven't added any books yet." : "#{@user.name} hasn't added any books yet." %></p>
<% end %>
