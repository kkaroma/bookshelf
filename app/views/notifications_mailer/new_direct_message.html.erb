<p style="margin-top:0;">Hi <%= @recipient.name %>,</p>
<p><strong><%= @message.sender.name %></strong> sent you a message on Bookshelf:</p>
<p style="margin:0; padding:12px 16px; background:#f1ede5; border-left:3px solid #e4ddd1; border-radius:0 8px 8px 0; white-space:pre-line;"><%= truncate(@message.body, length: 600) %></p>

<%= render "shared/email_button", text: "Reply", url: conversation_url(@message.conversation, anchor: "new_direct_message") %>
<%= render "notifications_mailer/footer", what: "“Messages”" %>
