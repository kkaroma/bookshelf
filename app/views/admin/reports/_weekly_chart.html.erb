<%# New records per week (AdminReport::Week list), drawn by shared/_bar_chart. %>
<% bars = weeks.map do |week|
     ReportBar.new(short_label: week.starts_on.strftime("%-d %b"), long_label: week.starts_on.strftime("%-d %B %Y"), count: week.count)
   end %>
<%= render "shared/bar_chart", id: id, title: title, noun: noun, bars: bars,
      span: "in #{weeks.size} weeks", table_heading: "Week starting", label_prefix: "Week of " %>
