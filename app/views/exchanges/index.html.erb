<% content_for :title, "Exchange shelf" %>

<div class="page-header">
  <div>
    <h1>Exchange shelf</h1>
    <p class="muted">
      <%= pluralize(@pagination.total_count, "book") %> members are happy to swap.
      <% if @my_count > 0 %>
        <%= @my_count == 1 ? "One of them is" : "#{@my_count} of them are" %> yours.
      <% end %>
    </p>
  </div>
  <%= link_to "My wishlist (#{Current.user.wishlist_items.size})", wishlist_items_path, class: "btn btn-secondary" %>
</div>

<p class="near-me">
  <% if @my_city %>
    📍 Books in <strong><%= @my_city %></strong> are shown first.
    <% if @near_only %>
      <%= link_to "Show books everywhere", exchanges_path %>
    <% else %>
      <%= link_to "Only near me", exchanges_path(near: 1) %>
    <% end %>
  <% else %>
    📍 <%= link_to "Add your town", edit_settings_profile_path %> to see books near you first.
  <% end %>
</p>

<% if @books.any? %>
  <div id="books" class="book-grid">
    <%= render partial: "books/book", collection: @books, locals: { show_city: true } %>
  </div>
  <%= render "shared/pagination", pagination: @pagination %>
<% else %>
  <div class="empty-state">
    <%= render "shared/book_icon", size: 48 %>
    <h2>Nothing on the shelf yet</h2>
    <p class="muted">
      Open one of your books and choose <strong>Offer for exchange</strong>
      to let other members know you'd swap it.
    </p>
    <%= link_to "Go to my books", books_path, class: "btn btn-primary" %>
  </div>
<% end %>
