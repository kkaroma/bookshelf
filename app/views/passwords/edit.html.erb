<% content_for :title, "Reset password" %>

<div class="auth">
  <div class="card auth-card">
    <div class="auth-header">
      <h1>Choose a new password</h1>
      <p class="muted">Make it at least 8 characters.</p>
    </div>

    <%= form_with url: password_path(params[:token]), method: :put, class: "form" do |form| %>
      <div class="field">
        <%= form.label :password, "New password" %>
        <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", minlength: 8, maxlength: 72, class: "input" %>
      </div>

      <div class="field">
        <%= form.label :password_confirmation, "Confirm new password" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
      </div>

      <%= form.submit "Save new password", class: "btn btn-primary btn-block" %>
    <% end %>
  </div>
</div>
