<%= link_to book, id: dom_id(book), class: "book-card" do %>
  <%= render "books/cover", book: book %>
  <div>
    <h2 class="book-card-title"><%= book.title %></h2>
    <% if book.subtitle.present? %>
      <p class="book-card-subtitle"><%= book.subtitle %></p>
    <% end %>
    <p class="book-card-meta">
      <%= book.author %><%= " · #{book.published_year}" if book.published_year %>
    </p>
    <% if book.ratings_count > 0 %>
      <p class="book-card-rating" title="<%= pluralize(book.ratings_count, "rating") %>">
        <span aria-hidden="true">★</span> <%= book.average_rating %>
        <span class="muted">(<%= book.ratings_count %>)</span>
      </p>
    <% end %>
    <% if book.owned_by?(Current.user) && book.loans.any?(&:outstanding?) %>
      <p class="book-card-status status-lent">Lent out</p>
    <% end %>
    <% if book.reading_status %>
      <p class="book-card-status status-<%= book.reading_status.dasherize %>"><%= book.reading_status_label %></p>
    <% end %>
    <p class="book-card-owner">
      Added by <%= book.owned_by?(Current.user) ? "you" : book.user.name %>
      <% if local_assigns[:show_city] && book.user.city %>
        · <span class="<%= "same-town" if book.user.same_city_as?(Current.user) %>">📍 <%= book.user.city %></span>
      <% end %>
    </p>
  </div>
<% end %>
