<%# The book's cover: its real image if it has one, otherwise a coloured
    cover generated from the title. size: :card (lists) or :large (book page) %>
<% size = local_assigns.fetch(:size, :card) %>
<% if book.cover_ready? %>
  <div class="book-cover book-cover-image" aria-hidden="true">
    <% if book.available_for_exchange? %>
      <span class="exchange-badge">For exchange</span>
    <% end %>
    <%= image_tag book.cover.variant(size), alt: "", loading: "lazy" %>
  </div>
<% else %>
  <div class="book-cover" style="--hue: <%= book_cover_hue(book) %>" aria-hidden="true">
    <% if book.available_for_exchange? %>
      <span class="exchange-badge">For exchange</span>
    <% end %>
    <span class="book-cover-title"><%= book.title %></span>
    <span class="book-cover-author"><%= book.author %></span>
  </div>
<% end %>
