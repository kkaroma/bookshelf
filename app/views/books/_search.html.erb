<%# Live search over a list of books, used on the Books page and on profiles.
    Rendered as a layout partial: the block passed in is shown when the list
    has no books at all (before any searching).

    Locals: url (where the form submits), query, books (this page's books),
    pagination, label (for the box), placeholder, total_label (e.g. "12 books
    on the shelf").

    Typing submits the form (after a short pause) into the books_results frame,
    so only the results change and the box keeps focus. Without JavaScript it's
    an ordinary search form. %>
<%= form_with url: url, method: :get, class: "search-form", html: { role: "search" },
      data: { controller: "search", turbo_frame: "books_results" } do |form| %>
  <%= form.label :q, label, class: "visually-hidden" %>
  <%= form.search_field :q, value: query, class: "input search-input", autocomplete: "off",
        placeholder: placeholder,
        data: { action: "input->search#queue search->search#submitNow" } %>
  <%= form.submit "Search", name: nil, class: "btn btn-secondary" %>
<% end %>

<%# target: "_top" makes links inside the frame (book cards, "Clear search") load
    the whole page, so "Clear search" also empties the search box. %>
<%= turbo_frame_tag "books_results", target: "_top" do %>
  <% if query.present? %>
    <p class="search-summary" aria-live="polite">
      <%= pluralize(pagination.total_count, "book") %> matching “<strong><%= query %></strong>”
      · <%= link_to "Clear search", url %>
    </p>
  <% elsif books.any? %>
    <p class="search-summary muted"><%= total_label %></p>
  <% end %>

  <% if books.any? %>
    <div id="books" class="book-grid">
      <%= render books %>
    </div>
    <%= render "shared/pagination", pagination: pagination %>
  <% elsif query.present? %>
    <div class="empty-state">
      <h2>No books match “<%= query %>”</h2>
      <p class="muted">Check the spelling, try fewer words, or search by the author's surname.</p>
      <%= link_to "Show all books", url, class: "btn btn-secondary" %>
    </div>
  <% else %>
    <%= yield %>
  <% end %>
<% end %>
