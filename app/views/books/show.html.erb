<% content_for :title, @book.title %>

<%= link_to "← All books", books_path, class: "back-link" %>

<article class="book-detail">
  <%= render "cover", book: @book, size: :large %>

  <div>
    <h1><%= @book.title %></h1>
    <% if @book.subtitle.present? %>
      <p class="book-subtitle"><%= @book.subtitle %></p>
    <% end %>
    <p class="book-detail-author">by <%= @book.author %></p>

    <% if @book.given_away? %>
      <p class="given-away-note">
        <% if @book.given_to %>
          <%= @book.owned_by?(Current.user) ? "You" : @book.user.name %> swapped this book to
          <%= link_to @book.given_to.name, @book.given_to %> on <%= l(@book.given_away_at.to_date, format: :long) %>.
          <% if @book.successor %><%= link_to "See #{@book.given_to.name.split.first}'s copy →", @book.successor %><% end %>
        <% else %>
          <%= @book.owned_by?(Current.user) ? "You no longer have" : "#{@book.user.name} no longer has" %> this book
          (since <%= l(@book.given_away_at.to_date, format: :long) %>). The review and comments stay here.
        <% end %>
      </p>
    <% elsif (earlier = @book.predecessor) %>
      <p class="given-away-note">
        Came to <%= @book.owned_by?(Current.user) ? "you" : @book.user.name %> from
        <%= link_to earlier.user.name, earlier.user %> in a swap.
        <%= link_to "See #{earlier.user.name.split.first}'s copy, review and comments →", earlier %>
      </p>
    <% end %>

    <div class="meta-list">
      <% if @book.published_year %>
        <span class="pill">Published <%= @book.published_year %></span>
      <% end %>
      <% if @book.isbn %>
        <span class="pill">ISBN <%= @book.isbn %></span>
      <% end %>
      <% if @book.genre %>
        <span class="pill"><%= @book.genre %></span>
      <% end %>
      <% if @book.reading_status && !@book.owned_by?(Current.user) %>
        <span class="pill">
          <%= @book.user.name.split.first %>
          <%= { "want_to_read" => "wants to read this", "reading" => "is reading this", "read" => "has read this" }[@book.reading_status] %>
        </span>
      <% end %>
      <% if @book.available_for_exchange? %>
        <span class="pill pill-exchange">⇄ Available for exchange</span>
      <% end %>
      <span class="pill"><%= @book.given_away? ? "Had by" : "Added by" %> <%= @book.owned_by?(Current.user) ? "you" : link_to(@book.user.name, @book.user) %> <%= time_ago_in_words(@book.created_at) %> ago</span>
    </div>

    <% if @book.publicly_visible? %>
      <div class="book-share">
        <%= render "shared/share_button", url: book_url(@book), title: "#{@book.title} — #{@book.user.name}'s review" %>
        <% if @book.owned_by?(Current.user) %><span class="muted">🌍 Anyone with the link can read this page.</span><% end %>
      </div>
    <% elsif @book.owned_by?(Current.user) %>
      <p class="visibility-note">🔒 Only members can see this page. <%= link_to "Make your profile public", edit_settings_profile_path %> to share your review.</p>
    <% end %>

    <%= render "books/reading_status", book: @book %>
    <%= render "books/rating", book: @book, my_rating: @my_rating %>
    <%= render "books/exchange_panel", book: @book, my_pending_request: @my_pending_request,
               pending_requests_count: @pending_requests_count %>

    <% if @book.description.present? %>
      <p class="book-description"><%= @book.description %></p>
    <% else %>
      <p class="muted">No description yet.</p>
    <% end %>

    <%= render "books/review", book: @book %>
    <%= render "books/lending", book: @book %>

    <% if can_edit?(@book) %>
      <div class="actions">
        <% unless @book.owned_by?(Current.user) %>
          <p class="admin-note">You're an admin, so you can change this book even though it isn't yours.</p>
        <% end %>
        <%= link_to "Edit book", edit_book_path(@book), class: "btn btn-secondary" %>
        <% if @book.given_away? %>
          <% unless @book.successor_id %>
            <%= button_to "Put back on my shelf", book_removal_path(@book), method: :delete, class: "btn btn-secondary" %>
          <% end %>
        <% else %>
          <% if @book.available_for_exchange? %>
            <%= button_to "Remove from exchange", book_exchange_listing_path(@book), method: :delete, class: "btn btn-secondary" %>
          <% else %>
            <%= button_to "Offer for exchange", book_exchange_listing_path(@book), class: "btn btn-secondary" %>
          <% end %>
          <%= button_to "I no longer have it", book_removal_path(@book), class: "btn btn-secondary",
                form: { data: { turbo_confirm: "Move “#{@book.title}” to “Books I've had”? Its review, comments and ratings stay on your profile." } } %>
        <% end %>
        <%= button_to "Delete book", @book, method: :delete, class: "btn btn-danger",
              form: { data: { turbo_confirm: "Delete “#{@book.title}” completely, with its review, comments and ratings? This can't be undone. (To keep them, use “I no longer have it”.)" } } %>
      </div>
    <% end %>

    <%= render "comments/section", book: @book, comments: @comments %>

    <% if @book.flaggable_by?(Current.user) %>
      <p class="report-link"><%= link_to "Report this book", new_flag_path(book_id: @book.id) %></p>
    <% end %>
  </div>
</article>
