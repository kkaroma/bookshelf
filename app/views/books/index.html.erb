<% content_for :title, @query.present? ? "Search: #{@query}" : "Books" %>

<div class="page-header">
  <div>
    <h1>Books</h1>
    <p class="muted">Search by title, author or ISBN.</p>
  </div>
  <%= link_to "Import from Goodreads", new_goodreads_import_path, class: "btn btn-secondary" %>
</div>

<%= render layout: "books/search", locals: {
      url: books_path, query: @query, books: @books, pagination: @pagination,
      label: "Search books", placeholder: "Search by title, author or ISBN…",
      total_label: "#{pluralize(@pagination.total_count, "book")} on the shelf" } do %>
  <div class="empty-state">
    <%= render "shared/book_icon", size: 48 %>
    <h2>Your shelf is empty</h2>
    <p class="muted">Add your first book to start building your collection.</p>
    <%= link_to "Add a book", new_book_path, class: "btn btn-primary" %>
  </div>
<% end %>
